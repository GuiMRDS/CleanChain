# Copie para .env (aqui ou na raiz do projeto) e preencha UMA das chaves.
# Sem LLM_PROVIDER, usa OpenAI se houver OPENAI_API_KEY; senão Groq.
GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# Opcional
# LLM_PROVIDER=groq            # força o provedor: groq | openai
# GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_MODEL=gpt-6.2-astra
