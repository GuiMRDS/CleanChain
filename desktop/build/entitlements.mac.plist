<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements do CleanChain com a assinatura da Apple (hardened runtime + notarização).
  Só usados quando o Release assina de verdade (docs/assinatura.md); o build ad hoc não usa.
  - allow-jit / allow-unsigned-executable-memory: o V8 do Electron e o Python empacotado.
  - disable-library-validation: o backend (PyInstaller) carrega bibliotecas do próprio pacote.
  - device.audio-input: o microfone do chat (só quando o usuário toca no botão de voz).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
